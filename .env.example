# Copy to .env for local runs. In CI define the same names as (secret) pipeline variables.
BASE_URL=https://your-env.appiancloud.com

# Roles that get a saved session (first = default role for tests)
APPIAN_ROLES=submitter,approver
APPIAN_SUBMITTER_USERNAME=test.submitter
APPIAN_SUBMITTER_PASSWORD=change-me
APPIAN_APPROVER_USERNAME=test.approver
APPIAN_APPROVER_PASSWORD=change-me

# Page the seed tests (agent entry points) open after login
APPIAN_HOME_PATH=/suite/

# Date format of the test users' Appian locale (resolves {{today}} placeholders)
APPIAN_DATE_FORMAT=MM/DD/YYYY

# Optional: service-account API key for Web API test-data setup
# APPIAN_API_KEY=
# Optional: override the busy-indicator selector used by waitForIdle()
# APPIAN_BUSY_SELECTOR=
# ENV_NAME=dev
